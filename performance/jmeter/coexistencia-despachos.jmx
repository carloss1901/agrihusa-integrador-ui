<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="AGRIHUSA - Coexistencia de despachos y reportes" enabled="true">
      <stringProp name="TestPlan.comments">Compara registro de despachos con consultas y reportes ejecutados individualmente y de forma simultánea.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="clienteId" elementType="Argument"><stringProp name="Argument.name">clienteId</stringProp><stringProp name="Argument.value">${__P(clienteId,1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="navieraId" elementType="Argument"><stringProp name="Argument.name">navieraId</stringProp><stringProp name="Argument.value">${__P(navieraId,1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="destinoId" elementType="Argument"><stringProp name="Argument.name">destinoId</stringProp><stringProp name="Argument.value">${__P(destinoId,2)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="operadorLogisticoId" elementType="Argument"><stringProp name="Argument.name">operadorLogisticoId</stringProp><stringProp name="Argument.value">${__P(operadorLogisticoId,1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="puertoLlegadaId" elementType="Argument"><stringProp name="Argument.name">puertoLlegadaId</stringProp><stringProp name="Argument.value">${__P(puertoLlegadaId,1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="productoId" elementType="Argument"><stringProp name="Argument.name">productoId</stringProp><stringProp name="Argument.value">${__P(productoId,1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="variedadId" elementType="Argument"><stringProp name="Argument.name">variedadId</stringProp><stringProp name="Argument.value">${__P(variedadId,1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="viaId" elementType="Argument"><stringProp name="Argument.name">viaId</stringProp><stringProp name="Argument.value">${__P(viaId,2)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="situacionId" elementType="Argument"><stringProp name="Argument.name">situacionId</stringProp><stringProp name="Argument.value">${__P(situacionId,1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="Servidor AGRIHUSA" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Variables HTTP"><collectionProp name="Arguments.arguments"/></elementProp>
        <stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp>
        <stringProp name="HTTPSampler.port">${__P(port,8085)}</stringProp>
        <stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
      </ConfigTestElement>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Servicio A - Registro de despachos" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Iteraciones A"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">${__P(loopsA,5)}</stringProp></elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(threadsA,2)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampA,2)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Cabeceras A" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="Content-Type" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
            <elementProp name="Accept" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
            <elementProp name="Authorization" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${tokenA}</stringProp></elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Autenticación A" enabled="true"/>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="SETUP_LOGIN_A" enabled="true">
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;usuario&quot;:&quot;${__groovy(System.getenv('E2E_OPERATOR_USER') ?: '')}&quot;,&quot;contrasenia&quot;:&quot;${__groovy(System.getenv('E2E_OPERATOR_PASSWORD') ?: '')}&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp>
            <stringProp name="HTTPSampler.path">/api/login</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extraer token A" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">tokenA</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.data</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues">TOKEN_NO_ENCONTRADO</stringProp></JSONPostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="A_REGISTRO_DESPACHO" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
<elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;despachoId&quot;:0,&quot;fechaDespacho&quot;:&quot;${__time(yyyy-MM-dd)}&quot;,&quot;fechaEstimadaLlegada&quot;:&quot;${__groovy(java.time.LocalDate.now().plusDays(7).toString())}&quot;,&quot;clienteId&quot;:${clienteId},&quot;navieraId&quot;:${navieraId},&quot;destinoId&quot;:${destinoId},&quot;operadorLogisticoId&quot;:${operadorLogisticoId},&quot;puertoLlegadaId&quot;:${puertoLlegadaId},&quot;productoId&quot;:${productoId},&quot;variedadId&quot;:${variedadId},&quot;viaId&quot;:${viaId},&quot;situacionId&quot;:${situacionId},&quot;cantidad&quot;:25,&quot;unidadMedida&quot;:&quot;KILOGRAMOS&quot;,&quot;numeroContenedor&quot;:&quot;JM${__time(yyMMddHHmmssSSS)}${__threadNum}${__counter(TRUE,)}&quot;,&quot;observaciones&quot;:&quot;PRUEBA JMETER COEXISTENCIA&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp>
          <stringProp name="HTTPSampler.path">/api/despachos</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Servicio B - Consultas y reportes" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Iteraciones B"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">${__P(loopsB,5)}</stringProp></elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(threadsB,2)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampB,2)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Cabeceras B" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="Content-Type" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
            <elementProp name="Accept" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
            <elementProp name="Authorization" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${tokenB}</stringProp></elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Autenticación B" enabled="true"/>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="SETUP_LOGIN_B" enabled="true">
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;usuario&quot;:&quot;${__groovy(System.getenv('E2E_OPERATOR_USER') ?: '')}&quot;,&quot;contrasenia&quot;:&quot;${__groovy(System.getenv('E2E_OPERATOR_PASSWORD') ?: '')}&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp>
            <stringProp name="HTTPSampler.path">/api/login</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extraer token B" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">tokenB</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.data</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues">TOKEN_NO_ENCONTRADO</stringProp></JSONPostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="B_CONSULTA_DESPACHOS" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
          <stringProp name="HTTPSampler.path">/api/despachos?pagina=1&amp;tamPagina=100</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="B_REPORTE_DESPACHOS" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
          <stringProp name="HTTPSampler.path">/api/despachos/reporte?activo=true</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
